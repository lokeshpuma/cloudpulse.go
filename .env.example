# CloudPulse Environment Configuration Example
# Copy to .env and replace all placeholder values before running in production.
# NEVER commit actual passwords, JWT secrets, or webhook credentials.

APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# PostgreSQL
POSTGRES_USER=cloudpulse
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=cloudpulse
DATABASE_URL=postgres://cloudpulse:change-me-strong-db-password@postgres:5432/cloudpulse?sslmode=disable

# Authentication Secrets (REQUIRED in production, minimum 32 chars)
JWT_SECRET=change-me-use-a-long-random-32-plus-char-secret-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_SECURE=false

# Monitoring Stack URLs (internal Docker network by default)
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_FILE_SD_PATH=/etc/prometheus/file_sd/targets.json
PROMETHEUS_RULES_DIR=/etc/prometheus/rules
PROMETHEUS_RELOAD_ENABLED=true

GRAFANA_URL=http://grafana:3000
GRAFANA_PUBLIC_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

ALERTMANAGER_URL=http://alertmanager:9093

# CORS & Logging
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8088
LOG_LEVEL=info

# Frontend public runtime variables (NO SECRETS HERE!)
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_ENV=development
VITE_DEMO_MODE=false

# Optional Alertmanager Notification Secrets (referenced by env / secret files)
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@example.com
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
