[Unit]
Description=CloudPulse Infrastructure Monitoring Agent
Documentation=https://github.com/cloudpulse/cloudpulse-go/blob/main/docs/agent-installation.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudpulse
Group=cloudpulse
ExecStart=/usr/local/bin/cloudpulse-agent --config /etc/cloudpulse/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# Security hardening (least privilege, non-root)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/
CapabilityBoundingSet=
AmbientCapabilities=

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloudpulse-agent

[Install]
WantedBy=multi-user.target
